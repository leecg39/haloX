# Copy to .env.local (never commit real values).
# Signs API session cookies/tokens. Use a random value of at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
HALOX_SESSION_SECRET=
# Password for the seeded local accounts (admin@halox.local, demo@halox.local, other@halox.local).
HALOX_DEMO_PASSWORD=
# Only for running a production build over plain http on localhost (e.g. E2E). Never set in deployment.
# HALOX_INSECURE_COOKIES=1
