# Copy to .env.local (never commit real values).
# Signs API session cookies/tokens. Use a random value of at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
HALOX_SESSION_SECRET=
# Password for the seeded local accounts (admin@halox.local, demo@halox.local, other@halox.local).
HALOX_DEMO_PASSWORD=
# Durable local database. Default: <project>/data/halox.sqlite.
# Production servers must mount this path on persistent local disk.
# HALOX_DATABASE_PATH=/absolute/path/to/halox.sqlite
# SOLAPI SMS authentication (server-only; sender must be registered with SOLAPI).
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
# OpenAI automatic translation. Server-only; never use a NEXT_PUBLIC_ variable.
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
# Optional stable encryption key (at least 32 random characters) for external
# credentials. Defaults to HALOX_SESSION_SECRET. Back up the key with the DB;
# changing it requires re-entering saved integration passwords.
# HALOX_INTEGRATION_SECRET=
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
# HALOX_TRUST_PROXY=1
# Only for running a production build over plain http on localhost (e.g. E2E). Never set in deployment.
# HALOX_INSECURE_COOKIES=1
# Daily GEO schedules run while the Node server is running (Korea time).
# HALOX_DISABLE_SCHEDULER=1
# HALOX_SCHEDULER_INTERVAL_MS=30000

# Pause the durable site-audit worker (queued scans remain saved). Independent of GEO schedules.
# HALOX_DISABLE_AUDIT_WORKER=1

# Stored-data monitoring and report scheduler (no external messaging).
# HALOX_DISABLE_OBSERVABILITY_WORKER=1
# HALOX_OBSERVABILITY_INTERVAL_MS=30000

# Account deletion: server startup + every 60 seconds; restore deadline stays enforced even if cleanup is disabled.
# Disable only for isolated tests; keep enabled on the persistent production server.
# HALOX_DISABLE_ACCOUNT_DELETION_WORKER=1

# Google OAuth web application. Enable Search Console, Analytics Admin and Data APIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/google/callback
# Optional: HALOX_DISABLE_GOOGLE_WORKER=1

# 알림 이메일: 기존 SMTP (465 TLS / 그 외 포트 STARTTLS 필수). 서버 전용.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=
# 문자 알림은 위 SOLAPI 설정을 공용 사용 (LMS)
# HALOX_DISABLE_NOTIFICATION_WORKER=1

# NicePay 정기결제 (서버 전용). Secret Key는 AES-256 빌링키 발급을 위해 32바이트여야 합니다.
NICEPAY_CLIENT_KEY=
NICEPAY_SECRET_KEY=
NICEPAY_MODE=sandbox
# 운영 웹훅: https://<서비스 도메인>/api/v1/billing/webhook
# HALOX_DISABLE_BILLING_WORKER=1
