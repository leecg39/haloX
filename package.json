{
  "name": "halox-local-clone",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "prepare:content": "node scripts/prepare-content.mjs",
    "verify:routes": "node scripts/verify-routes.mjs",
    "verify:crud-coverage": "node scripts/verify-crud-coverage.mjs",
    "verify:public": "node scripts/verify-rea-public.mjs",
    "diff:manifest": "node scripts/diff-manifest.mjs",
    "verify:visual": "node scripts/verify-visual-regression.mjs",
    "verify:backend": "node --experimental-strip-types scripts/verify-backend.mjs",
    "backup:data": "node --experimental-strip-types scripts/backup-store.mjs",
    "restore:data": "node --experimental-strip-types scripts/restore-store.mjs",
    "test:e2e": "playwright test",
    "test:unit": "node --experimental-strip-types --test src/lib/metrics/index.test.ts src/lib/backend/*.test.ts",
    "verify:sql": "bash scripts/verify-supabase-sql.sh",
    "test:quota": "node --experimental-strip-types --test src/lib/backend/quota-units.test.ts",
    "test:metrics": "node --experimental-strip-types --test --experimental-test-coverage --test-coverage-include=src/lib/metrics/index.ts src/lib/metrics/index.test.ts",
    "verify:parity": "node scripts/verify-parity.mjs",
    "capture:parity": "node scripts/capture-parity.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "agentation": "^3.1.2",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-react-parser": "^5.2.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "nodemailer": "^10.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "robots-parser": "3.0.1",
    "saxes": "6.0.0",
    "tailwind-merge": "^3.3.1",
    "tldts": "7.4.19"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3"
  }
}